pipeline {
    agent any

    tools {
        jdk 'jdk17'
        nodejs 'node22'
    }

    environment {
        SCANNER_HOME = tool 'sonar-scanner'
    }

    stages {

        stage('Clean Workspace') {
            steps {
                cleanWs()
            }
        }

        stage('Checkout from Git') {
            steps {
                git branch: 'feature',
                    url: 'https://github.com/yuvakishor123/Bms-project.git'

                sh '''
                    echo "=== Workspace ==="
                    ls -la

                    echo "=== Application ==="
                    ls -la bookmyshow-app
                '''
            }
        }

        stage('Install Dependencies') {
            steps {
                dir('bookmyshow-app') {
                    sh '''
                        echo "Node version:"
                        node --version

                        echo "NPM version:"
                        npm --version

                        if [ -f package.json ]; then
                            npm ci --no-audit --no-fund
                        else
                            echo "ERROR: package.json not found!"
                            exit 1
                        fi
                    '''
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    withSonarQubeEnv('sonar-server') {
                        sh '''
                            echo "Node used by Jenkins:"
                            which node
                            node --version

                            echo "Starting SonarQube analysis..."

                            $SCANNER_HOME/bin/sonar-scanner \
                                -Dsonar.projectName=BMS \
                                -Dsonar.projectKey=BMS \
                                -Dsonar.sources=bookmyshow-app \
                                -Dsonar.exclusions=**/node_modules/**,**/build/**,**/dist/**,**/*.png,**/*.jpg,**/*.jpeg,**/*.JPG,**/*.gif,**/*.ico,**/*.svg,**/*.woff,**/*.woff2,**/*.ttf \
                                -Dsonar.nodejs.executable="$(which node)" \
                                -Dsonar.sourceEncoding=UTF-8
                        '''
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('OWASP FS Scan') {
            steps {
                dependencyCheck(
                    additionalArguments: '--scan ./bookmyshow-app --disableYarnAudit --disableNodeAudit',
                    odcInstallation: 'DP-Check'
                )

                dependencyCheckPublisher(
                    pattern: '**/dependency-check-report.xml'
                )
            }
        }

        stage('Trivy FS Scan') {
            steps {
                sh '''
                    echo "Running Trivy filesystem scan..."

                    trivy fs ./bookmyshow-app \
                        --severity HIGH,CRITICAL \
                        --format table \
                        -o trivyfs.txt
                '''
            }
        }

        stage('Docker Build & Push') {
            steps {
                script {
                    withDockerRegistry(
                        credentialsId: 'docker',
                        toolName: 'docker'
                    ) {
                        sh '''
                            echo "Building Docker image..."

                            docker build \
                                --no-cache \
                                -t yuvakishor/bms-new:v1 \
                                -f bookmyshow-app/Dockerfile \
                                bookmyshow-app

                            echo "Pushing Docker image to registry..."

                            docker push yuvakishor/bms-new:v1
                        '''
                    }
                }
            }
        }

        stage('Trivy Image Scan') {
            steps {
                sh '''
                    echo "Running Trivy Docker image scan..."

                    trivy image \
                        --severity HIGH,CRITICAL \
                        --format table \
                        -o trivyimage.txt \
                        yuvakishor/bms-new:v1
                '''
            }
        }

        stage('Deploy to Container') {
            steps {
                sh '''
                    echo "Stopping and removing old container..."

                    docker stop bms-new || true
                    docker rm bms-new || true

                    echo "Running new container on port 5685..."

                    docker run -d \
                        --restart=always \
                        --name bms-new \
                        -p 5685:5685 \
                        yuvakishor/bms-new:v1

                    echo "Checking running containers..."

                    docker ps -a

                    echo "Fetching logs..."

                    sleep 5

                    docker logs bms-new
                '''
            }
        }
    }

    post {
        always {
            emailext(
                attachLog: true,
                subject: "${currentBuild.result}",
                body: """
                    Project: ${env.JOB_NAME}<br/>
                    Build Number: ${env.BUILD_NUMBER}<br/>
                    URL: ${env.BUILD_URL}<br/>
                """,
                to: 'yuvakishor5685@gmail.com',
                attachmentsPattern: 'trivyfs.txt,trivyimage.txt'
            )
        }
    }
}
